{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "otrio-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",

  "assets": {
    "not_found_handling": "single-page-application",
		"run_worker_first": [
      "/api/*"
    ]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },

	"ratelimits": [
		{
			"name": "ROOM_CREATE_RATE_LIMITER",
			"namespace_id": "248731001",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "ROOM_ACCESS_RATE_LIMITER",
			"namespace_id": "248731002",
			"simple": { "limit": 60, "period": 60 }
		}
	],

	"exports": {
    "GameRoom": {
  	  "type": "durable-object",
      "storage": "sqlite"
	  }
  }
}
