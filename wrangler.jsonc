{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "otrio-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",

  "assets": {
    "not_found_handling": "single-page-application",
		"run_worker_first": [
      "/api/*"
    ]
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },

	"exports": {
    "GameRoom": {
  	  "type": "durable-object",
      "storage": "sqlite"
	  }
  }
}
